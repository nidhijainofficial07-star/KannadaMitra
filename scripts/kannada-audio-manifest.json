[
  {
    "text": "ನಮಸ್ಕಾರ",
    "file": "namaskara.mp3"
  },
  {
    "text": "ಧನ್ಯವಾದಗಳು",
    "file": "thanks.mp3"
  },
  {
    "text": "ದಯವಿಟ್ಟು",
    "file": "kn-003.mp3"
  },
  {
    "text": "ಹೌದು",
    "file": "kn-004.mp3"
  },
  {
    "text": "ಇಲ್ಲ",
    "file": "kn-005.mp3"
  },
  {
    "text": "ನನಗೆ ಅರ್ಥವಾಗಲಿಲ್ಲ.",
    "file": "kn-006.mp3"
  },
  {
    "text": "ಸ್ವಲ್ಪ ನಿಧಾನವಾಗಿ ಮಾತನಾಡಿ.",
    "file": "kn-007.mp3"
  },
  {
    "text": "ನಿಮಗೆ ಇಂಗ್ಲಿಷ್ ಗೊತ್ತಾ?",
    "file": "kn-008.mp3"
  },
  {
    "text": "ದಯವಿಟ್ಟು ಸಹಾಯ ಮಾಡಿ!",
    "file": "kn-009.mp3"
  },
  {
    "text": "ಆಸ್ಪತ್ರೆ ಎಲ್ಲಿದೆ?",
    "file": "kn-010.mp3"
  },
  {
    "text": "ನನಗೆ ನೀರು ಬೇಕು.",
    "file": "kn-011.mp3"
  },
  {
    "text": "ಶೌಚಾಲಯ ಎಲ್ಲಿದೆ?",
    "file": "kn-012.mp3"
  },
  {
    "text": "ನೇರವಾಗಿ ಹೋಗಿ.",
    "file": "kn-013.mp3"
  },
  {
    "text": "ಇದು ಎಲ್ಲಿದೆ?",
    "file": "kn-014.mp3"
  },
  {
    "text": "ಇದು ಹತ್ತಿರ ಇದೆಯಾ?",
    "file": "kn-015.mp3"
  },
  {
    "text": "ಇದರ ಬೆಲೆ ಎಷ್ಟು?",
    "file": "kn-016.mp3"
  },
  {
    "text": "ಸ್ವಲ್ಪ ಕಡಿಮೆ ಮಾಡಿ.",
    "file": "kn-017.mp3"
  },
  {
    "text": "ಬೇರೆ ಬಣ್ಣ ಇದೆಯಾ?",
    "file": "kn-018.mp3"
  },
  {
    "text": "ಇಲ್ಲೇ ನಿಲ್ಲಿಸಿ.",
    "file": "kn-019.mp3"
  },
  {
    "text": "ಈ ಬಸ್ ಮೆಜೆಸ್ಟಿಕ್‌ಗೆ ಹೋಗುತ್ತದೆಯಾ?",
    "file": "kn-020.mp3"
  },
  {
    "text": "ಎಷ್ಟು ಸಮಯ ಆಗುತ್ತದೆ?",
    "file": "kn-021.mp3"
  },
  {
    "text": "ಹೇಗಿದ್ದೀರಾ?",
    "file": "kn-022.mp3"
  },
  {
    "text": "ನಿಮ್ಮ ಹೆಸರು ಏನು?",
    "file": "kn-023.mp3"
  },
  {
    "text": "ನಿಮ್ಮನ್ನು ಭೇಟಿಯಾಗಿ ಸಂತೋಷವಾಯಿತು.",
    "file": "kn-024.mp3"
  },
  {
    "text": "ನಾನು ದಾರಿ ತಪ್ಪಿದ್ದೇನೆ.",
    "file": "kn-025.mp3"
  },
  {
    "text": "ನನಗೆ ಒಂದು ದೋಸೆ ಬೇಕು.",
    "file": "kn-026.mp3"
  },
  {
    "text": "ಎರಡು ಇಡ್ಲಿ ಕೊಡಿ.",
    "file": "kn-027.mp3"
  },
  {
    "text": "ನಾನು ಊಟ ಆರ್ಡರ್ ಮಾಡಬೇಕು.",
    "file": "kn-028.mp3"
  },
  {
    "text": "ಇಲ್ಲಿ ಕುಳಿತುಕೊಳ್ಳಬಹುದಾ?",
    "file": "kn-029.mp3"
  },
  {
    "text": "ಏನು ಚೆನ್ನಾಗಿದೆ?",
    "file": "kn-030.mp3"
  },
  {
    "text": "ಒಂದು ಪ್ಲೇಟ್ ಪೂರಿ ಕೊಡಿ.",
    "file": "kn-031.mp3"
  },
  {
    "text": "ಪಾರ್ಸೆಲ್ ಮಾಡಿ ಕೊಡಿ.",
    "file": "kn-032.mp3"
  },
  {
    "text": "ಧನ್ಯವಾದಗಳು, ಊಟ ಚೆನ್ನಾಗಿತ್ತು.",
    "file": "kn-033.mp3"
  },
  {
    "text": "ಮೆನು ಕೊಡುತ್ತೀರಾ?",
    "file": "kn-034.mp3"
  },
  {
    "text": "ಇದು ಏನು?",
    "file": "kn-035.mp3"
  },
  {
    "text": "ಇದರಲ್ಲಿ ಏನು ಇದೆ?",
    "file": "kn-036.mp3"
  },
  {
    "text": "ಇದು ಸಸ್ಯಾಹಾರಿಯೇ?",
    "file": "kn-037.mp3"
  },
  {
    "text": "ಇಂದು ವಿಶೇಷ ಏನು?",
    "file": "kn-038.mp3"
  },
  {
    "text": "ಇದು ಈಗ ಸಿಗುತ್ತದೆಯಾ?",
    "file": "kn-039.mp3"
  },
  {
    "text": "ಯಾವುದು ಹೆಚ್ಚು ಜನಪ್ರಿಯ?",
    "file": "kn-040.mp3"
  },
  {
    "text": "ಬೆಲೆ ಎಲ್ಲಿ ಬರೆದಿದೆ?",
    "file": "kn-041.mp3"
  },
  {
    "text": "ಸ್ವಲ್ಪ ಕಡಿಮೆ ಖಾರ ಮಾಡಿ.",
    "file": "kn-042.mp3"
  },
  {
    "text": "ಈರುಳ್ಳಿ ಬೇಡ.",
    "file": "kn-043.mp3"
  },
  {
    "text": "ಎಣ್ಣೆ ಕಡಿಮೆ ಹಾಕಿ.",
    "file": "kn-044.mp3"
  },
  {
    "text": "ಸಕ್ಕರೆ ಹಾಕಬೇಡಿ.",
    "file": "kn-045.mp3"
  },
  {
    "text": "ಸ್ವಲ್ಪ ಬಿಸಿ ಮಾಡಿ ಕೊಡಿ.",
    "file": "kn-046.mp3"
  },
  {
    "text": "ಸಾಂಬಾರ್ ಬೇರೆ ಕೊಡಿ.",
    "file": "kn-047.mp3"
  },
  {
    "text": "ಇದನ್ನು ಮೊಟ್ಟೆ ಇಲ್ಲದೆ ಮಾಡಬಹುದಾ?",
    "file": "kn-048.mp3"
  },
  {
    "text": "ನನಗೆ ಕಡಲೆಕಾಯಿ ಅಲರ್ಜಿ ಇದೆ.",
    "file": "kn-049.mp3"
  },
  {
    "text": "ಒಂದು ಫಿಲ್ಟರ್ ಕಾಫಿ ಕೊಡಿ.",
    "file": "kn-050.mp3"
  },
  {
    "text": "ಕಾಫಿಯಲ್ಲಿ ಸಕ್ಕರೆ ಕಡಿಮೆ ಹಾಕಿ.",
    "file": "kn-051.mp3"
  },
  {
    "text": "ತಣ್ಣೀರಿದೆಯಾ?",
    "file": "kn-052.mp3"
  },
  {
    "text": "ಮಜ್ಜಿಗೆ ಕೊಡಿ.",
    "file": "kn-053.mp3"
  },
  {
    "text": "ಯಾವ ಸಿಹಿ ತಿಂಡಿ ಇದೆ?",
    "file": "kn-054.mp3"
  },
  {
    "text": "ಒಂದು ಮೈಸೂರು ಪಾಕ್ ಕೊಡಿ.",
    "file": "kn-055.mp3"
  },
  {
    "text": "ಇನ್ನೊಂದು ಕಪ್ ಚಹಾ ಬೇಕು.",
    "file": "kn-056.mp3"
  },
  {
    "text": "ಬಿಲ್ ಕೊಡಿ, ದಯವಿಟ್ಟು.",
    "file": "kn-057.mp3"
  },
  {
    "text": "ಒಟ್ಟು ಎಷ್ಟು ಆಯಿತು?",
    "file": "kn-058.mp3"
  },
  {
    "text": "ಕಾರ್ಡ್ ತೆಗೆದುಕೊಳ್ಳುತ್ತೀರಾ?",
    "file": "kn-059.mp3"
  },
  {
    "text": "ಯುಪಿಐ ಮೂಲಕ ಕೊಡಬಹುದಾ?",
    "file": "kn-060.mp3"
  },
  {
    "text": "ಚಿಲ್ಲರೆ ಇದೆಯಾ?",
    "file": "kn-061.mp3"
  },
  {
    "text": "ಬಿಲ್‌ನಲ್ಲಿ ತಪ್ಪಿದೆ.",
    "file": "kn-062.mp3"
  },
  {
    "text": "ಬಿಲ್ ಅನ್ನು ಬೇರೆ ಬೇರೆ ಮಾಡಿ.",
    "file": "kn-063.mp3"
  },
  {
    "text": "ರಸೀದಿ ಕೊಡಿ.",
    "file": "kn-064.mp3"
  },
  {
    "text": "ಮೆಜೆಸ್ಟಿಕ್‌ಗೆ ಬರುತ್ತೀರಾ?",
    "file": "kn-065.mp3"
  },
  {
    "text": "ಸ್ವಲ್ಪ ಬೇಗ ಹೋಗಿ.",
    "file": "kn-066.mp3"
  },
  {
    "text": "ಮೀಟರ್ ಹಾಕಿ.",
    "file": "kn-067.mp3"
  },
  {
    "text": "ಈ ವಿಳಾಸಕ್ಕೆ ಹೋಗಬೇಕು.",
    "file": "kn-068.mp3"
  },
  {
    "text": "ಮುಂದೆ ಎಡಕ್ಕೆ ತಿರುಗಿ.",
    "file": "kn-069.mp3"
  },
  {
    "text": "ಇಲ್ಲಿ ಇಳಿಯುತ್ತೇನೆ.",
    "file": "kn-070.mp3"
  },
  {
    "text": "ಬಸ್ ನಿಲ್ದಾಣ ಎಲ್ಲಿದೆ?",
    "file": "kn-071.mp3"
  },
  {
    "text": "ಈ ಬಸ್ ಮೈಸೂರಿಗೆ ಹೋಗುತ್ತದೆಯಾ?",
    "file": "kn-072.mp3"
  },
  {
    "text": "ಮುಂದಿನ ಬಸ್ ಯಾವಾಗ?",
    "file": "kn-073.mp3"
  },
  {
    "text": "ಒಂದು ಟಿಕೆಟ್ ಕೊಡಿ.",
    "file": "kn-074.mp3"
  },
  {
    "text": "ನನ್ನ ನಿಲ್ದಾಣ ಬಂದಾಗ ಹೇಳಿ.",
    "file": "kn-075.mp3"
  },
  {
    "text": "ಈ ಸೀಟು ಖಾಲಿ ಇದೆಯಾ?",
    "file": "kn-076.mp3"
  },
  {
    "text": "ಬಸ್ ತುಂಬಾ ಜನ ಇದೆಯಾ?",
    "file": "kn-077.mp3"
  },
  {
    "text": "ಕೊನೆಯ ಬಸ್ ಎಷ್ಟು ಗಂಟೆಗೆ?",
    "file": "kn-078.mp3"
  },
  {
    "text": "ರೈಲು ನಿಲ್ದಾಣ ಎಲ್ಲಿದೆ?",
    "file": "kn-079.mp3"
  },
  {
    "text": "ಅಲ್ಲಿಗೆ ಹೇಗೆ ಹೋಗುವುದು?",
    "file": "kn-080.mp3"
  },
  {
    "text": "ಇದು ಇಲ್ಲಿಂದ ದೂರವೇ?",
    "file": "kn-081.mp3"
  },
  {
    "text": "ನೇರವಾಗಿ ಹೋಗಬೇಕಾ?",
    "file": "kn-082.mp3"
  },
  {
    "text": "ಎಡಕ್ಕೆ ತಿರುಗಬೇಕಾ?",
    "file": "kn-083.mp3"
  },
  {
    "text": "ಹತ್ತಿರದ ಮೆಟ್ರೋ ನಿಲ್ದಾಣ ಯಾವುದು?",
    "file": "kn-084.mp3"
  },
  {
    "text": "ನನಗೆ ದಾರಿ ತೋರಿಸುತ್ತೀರಾ?",
    "file": "kn-085.mp3"
  },
  {
    "text": "ಟಿಕೆಟ್ ಬೆಲೆ ಎಷ್ಟು?",
    "file": "kn-086.mp3"
  },
  {
    "text": "ಎರಡು ಟಿಕೆಟ್ ಕೊಡಿ.",
    "file": "kn-087.mp3"
  },
  {
    "text": "ಒನ್ ವೇ ಟಿಕೆಟ್ ಬೇಕು.",
    "file": "kn-088.mp3"
  },
  {
    "text": "ರಿಟರ್ನ್ ಟಿಕೆಟ್ ಸಿಗುತ್ತದೆಯಾ?",
    "file": "kn-089.mp3"
  },
  {
    "text": "ವಿದ್ಯಾರ್ಥಿ ರಿಯಾಯಿತಿ ಇದೆಯಾ?",
    "file": "kn-090.mp3"
  },
  {
    "text": "ಆನ್‌ಲೈನ್‌ನಲ್ಲಿ ಬುಕ್ ಮಾಡಬಹುದಾ?",
    "file": "kn-091.mp3"
  },
  {
    "text": "ನಗದು ಮಾತ್ರವೇ?",
    "file": "kn-092.mp3"
  },
  {
    "text": "ನನ್ನ ಟಿಕೆಟ್ ದೃಢಪಟ್ಟಿದೆಯಾ?",
    "file": "kn-093.mp3"
  },
  {
    "text": "ಬಸ್ ತಡವಾಗಿದೆಯಾ?",
    "file": "kn-094.mp3"
  },
  {
    "text": "ನಾನು ನಿಲ್ದಾಣ ತಪ್ಪಿಸಿಕೊಂಡೆ.",
    "file": "kn-095.mp3"
  },
  {
    "text": "ಈ ರೈಲು ರದ್ದಾಗಿದೆಯಾ?",
    "file": "kn-096.mp3"
  },
  {
    "text": "ಬೇರೆ ಮಾರ್ಗ ಇದೆಯಾ?",
    "file": "kn-097.mp3"
  },
  {
    "text": "ನನ್ನ ಬ್ಯಾಗ್ ಕಾಣುತ್ತಿಲ್ಲ.",
    "file": "kn-098.mp3"
  },
  {
    "text": "ಟಿಕೆಟ್ ಬದಲಾಯಿಸಬಹುದಾ?",
    "file": "kn-099.mp3"
  },
  {
    "text": "ಸಹಾಯ ಕೇಂದ್ರ ಎಲ್ಲಿದೆ?",
    "file": "kn-100.mp3"
  },
  {
    "text": "ನಾನು ಯಾರನ್ನು ಕೇಳಬೇಕು?",
    "file": "kn-101.mp3"
  },
  {
    "text": "ಅದರ ಬೆಲೆ ಎಷ್ಟು?",
    "file": "kn-102.mp3"
  },
  {
    "text": "ಇದು ತುಂಬಾ ದುಬಾರಿ.",
    "file": "kn-103.mp3"
  },
  {
    "text": "ಕಡಿಮೆ ಬೆಲೆಯದು ಇದೆಯಾ?",
    "file": "kn-104.mp3"
  },
  {
    "text": "ಎರಡರ ಬೆಲೆ ಹೇಳಿ.",
    "file": "kn-105.mp3"
  },
  {
    "text": "ಬೆಲೆ ನಿಗದಿಯೇ?",
    "file": "kn-106.mp3"
  },
  {
    "text": "ತೆರಿಗೆ ಸೇರಿಸಿದೆಯಾ?",
    "file": "kn-107.mp3"
  },
  {
    "text": "ಬೆಲೆ ಪಟ್ಟಿ ಇದೆಯಾ?",
    "file": "kn-108.mp3"
  },
  {
    "text": "ಇದು ನನ್ನ ಬಜೆಟ್‌ಗಿಂತ ಹೆಚ್ಚು.",
    "file": "kn-109.mp3"
  },
  {
    "text": "ಕೊನೆಯ ಬೆಲೆ ಎಷ್ಟು?",
    "file": "kn-110.mp3"
  },
  {
    "text": "ಎರಡು ತೆಗೆದುಕೊಂಡರೆ ಕಡಿಮೆ ಮಾಡುತ್ತೀರಾ?",
    "file": "kn-111.mp3"
  },
  {
    "text": "ಇನ್ನೊಂದು ಅಂಗಡಿಯಲ್ಲಿ ಕಡಿಮೆ ಇದೆ.",
    "file": "kn-112.mp3"
  },
  {
    "text": "ಐನೂರು ರೂಪಾಯಿಗೆ ಕೊಡುತ್ತೀರಾ?",
    "file": "kn-113.mp3"
  },
  {
    "text": "ಸರಿ, ನಾನು ತೆಗೆದುಕೊಳ್ಳುತ್ತೇನೆ.",
    "file": "kn-114.mp3"
  },
  {
    "text": "ಬೇಡ, ಧನ್ಯವಾದಗಳು.",
    "file": "kn-115.mp3"
  },
  {
    "text": "ಒಂದು ಕಿಲೋ ಅಕ್ಕಿ ಕೊಡಿ.",
    "file": "kn-116.mp3"
  },
  {
    "text": "ಅರ್ಧ ಕಿಲೋ ಟೊಮೇಟೊ ಬೇಕು.",
    "file": "kn-117.mp3"
  },
  {
    "text": "ಆರು ಬಾಳೆಹಣ್ಣು ಕೊಡಿ.",
    "file": "kn-118.mp3"
  },
  {
    "text": "ಇದು ತಾಜಾ ಇದೆಯಾ?",
    "file": "kn-119.mp3"
  },
  {
    "text": "ಇನ್ನೂ ಸ್ವಲ್ಪ ಕೊಡಿ.",
    "file": "kn-120.mp3"
  },
  {
    "text": "ಚಿಕ್ಕ ಪ್ಯಾಕೆಟ್ ಬೇಕು.",
    "file": "kn-121.mp3"
  },
  {
    "text": "ಇಷ್ಟು ಸಾಕು.",
    "file": "kn-122.mp3"
  },
  {
    "text": "ಚೀಲ ಕೊಡಿ, ದಯವಿಟ್ಟು.",
    "file": "kn-123.mp3"
  },
  {
    "text": "ದೊಡ್ಡ ಸೈಜ್ ಇದೆಯಾ?",
    "file": "kn-124.mp3"
  },
  {
    "text": "ಇದನ್ನು ಹಾಕಿ ನೋಡಬಹುದಾ?",
    "file": "kn-125.mp3"
  },
  {
    "text": "ಟ್ರಯಲ್ ರೂಮ್ ಎಲ್ಲಿದೆ?",
    "file": "kn-126.mp3"
  },
  {
    "text": "ಇದು ನನಗೆ ಸರಿಯಾಗಿದೆ.",
    "file": "kn-127.mp3"
  },
  {
    "text": "ಇದು ಸ್ವಲ್ಪ ಬಿಗಿಯಾಗಿದೆ.",
    "file": "kn-128.mp3"
  },
  {
    "text": "ಹತ್ತಿ ಬಟ್ಟೆ ಬೇಕು.",
    "file": "kn-129.mp3"
  },
  {
    "text": "ನಾನು ಇದನ್ನು ತೆಗೆದುಕೊಳ್ಳುತ್ತೇನೆ.",
    "file": "kn-130.mp3"
  },
  {
    "text": "ಯುಪಿಐ ಸ್ಕ್ಯಾನ್ ಎಲ್ಲಿ?",
    "file": "kn-131.mp3"
  },
  {
    "text": "ಕಾರ್ಡ್ ಮೂಲಕ ಪಾವತಿಸುತ್ತೇನೆ.",
    "file": "kn-132.mp3"
  },
  {
    "text": "ರಸೀದಿ ಬೇಕು.",
    "file": "kn-133.mp3"
  },
  {
    "text": "ಪಾವತಿ ಆಗಿದೆಯಾ?",
    "file": "kn-134.mp3"
  },
  {
    "text": "ಈ ವಸ್ತುವನ್ನು ವಾಪಸ್ ಕೊಡಬೇಕು.",
    "file": "kn-135.mp3"
  },
  {
    "text": "ಬದಲಾಯಿಸಿಕೊಳ್ಳಬಹುದಾ?",
    "file": "kn-136.mp3"
  },
  {
    "text": "ಇದು ಹಾಳಾಗಿದೆ.",
    "file": "kn-137.mp3"
  },
  {
    "text": "ಹಣ ವಾಪಸ್ ಯಾವಾಗ ಬರುತ್ತದೆ?",
    "file": "kn-138.mp3"
  },
  {
    "text": "ನಮಸ್ಕಾರ, ನನ್ನ ಹೆಸರು ಅನಿಲ್.",
    "file": "kn-139.mp3"
  },
  {
    "text": "ನಾನು ಮೊದಲ ವರ್ಷದ ವಿದ್ಯಾರ್ಥಿ.",
    "file": "kn-140.mp3"
  },
  {
    "text": "ನೀವು ಯಾವ ವಿಭಾಗದಲ್ಲಿ ಓದುತ್ತಿದ್ದೀರಿ?",
    "file": "kn-141.mp3"
  },
  {
    "text": "ನಾನು ಕಂಪ್ಯೂಟರ್ ಸೈನ್ಸ್ ಓದುತ್ತಿದ್ದೇನೆ.",
    "file": "kn-142.mp3"
  },
  {
    "text": "ನೀವು ಎಲ್ಲಿಂದ ಬಂದಿದ್ದೀರಿ?",
    "file": "kn-143.mp3"
  },
  {
    "text": "ನಾನು ಕನ್ನಡ ಕಲಿಯುತ್ತಿದ್ದೇನೆ.",
    "file": "kn-144.mp3"
  },
  {
    "text": "ನಾವು ಒಟ್ಟಿಗೆ ಓದೋಣವಾ?",
    "file": "kn-145.mp3"
  },
  {
    "text": "ನಿಮ್ಮ ನೋಟ್ಸ್ ಕೊಡುತ್ತೀರಾ?",
    "file": "kn-146.mp3"
  },
  {
    "text": "ಇಂದಿನ ತರಗತಿ ಹೇಗಿತ್ತು?",
    "file": "kn-147.mp3"
  },
  {
    "text": "ಅಸೈನ್‌ಮೆಂಟ್ ಮುಗಿಸಿದ್ದೀರಾ?",
    "file": "kn-148.mp3"
  },
  {
    "text": "ಗುಂಪಿನಲ್ಲಿ ನನ್ನನ್ನೂ ಸೇರಿಸಿ.",
    "file": "kn-149.mp3"
  },
  {
    "text": "ನಾಳೆ ಕಾಲೇಜಿಗೆ ಬರುತ್ತೀರಾ?",
    "file": "kn-150.mp3"
  },
  {
    "text": "ಕ್ಯಾಂಟೀನ್‌ಗೆ ಹೋಗೋಣವಾ?",
    "file": "kn-151.mp3"
  },
  {
    "text": "ನಂತರ ಭೇಟಿಯಾಗೋಣ.",
    "file": "kn-152.mp3"
  },
  {
    "text": "ತರಗತಿ ಎಲ್ಲಿ ನಡೆಯುತ್ತದೆ?",
    "file": "kn-153.mp3"
  },
  {
    "text": "ರೂಮ್ ನಂಬರ್ ಎಷ್ಟು?",
    "file": "kn-154.mp3"
  },
  {
    "text": "ಲ್ಯಾಬ್ ಯಾವ ಮಹಡಿಯಲ್ಲಿದೆ?",
    "file": "kn-155.mp3"
  },
  {
    "text": "ತರಗತಿ ಎಷ್ಟು ಗಂಟೆಗೆ ಶುರು?",
    "file": "kn-156.mp3"
  },
  {
    "text": "ಇಂದು ತರಗತಿ ಇದೆಯಾ?",
    "file": "kn-157.mp3"
  },
  {
    "text": "ಟೈಮ್‌ಟೇಬಲ್ ಎಲ್ಲಿ ಸಿಗುತ್ತದೆ?",
    "file": "kn-158.mp3"
  },
  {
    "text": "ಗ್ರಂಥಾಲಯ ಯಾವ ಕಡೆ ಇದೆ?",
    "file": "kn-159.mp3"
  },
  {
    "text": "ಮೇಡಂ, ನನಗೆ ಒಂದು ಸಂದೇಹ ಇದೆ.",
    "file": "kn-160.mp3"
  },
  {
    "text": "ಮತ್ತೊಮ್ಮೆ ವಿವರಿಸುತ್ತೀರಾ?",
    "file": "kn-161.mp3"
  },
  {
    "text": "ನನಗೆ ಇದು ಅರ್ಥವಾಗಲಿಲ್ಲ.",
    "file": "kn-162.mp3"
  },
  {
    "text": "ಉದಾಹರಣೆ ಕೊಡುತ್ತೀರಾ?",
    "file": "kn-163.mp3"
  },
  {
    "text": "ಅಸೈನ್‌ಮೆಂಟ್ ಯಾವಾಗ ಕೊಡಬೇಕು?",
    "file": "kn-164.mp3"
  },
  {
    "text": "ಒಳಗೆ ಬರಬಹುದಾ, ಸರ್?",
    "file": "kn-165.mp3"
  },
  {
    "text": "ತಡವಾಗಿ ಬಂದಿದ್ದಕ್ಕೆ ಕ್ಷಮಿಸಿ.",
    "file": "kn-166.mp3"
  },
  {
    "text": "ನಿಮ್ಮನ್ನು ನಂತರ ಭೇಟಿಯಾಗಬಹುದಾ?",
    "file": "kn-167.mp3"
  },
  {
    "text": "ವಿದ್ಯಾರ್ಥಿ ಕಚೇರಿ ಎಲ್ಲಿದೆ?",
    "file": "kn-168.mp3"
  },
  {
    "text": "ಗುರುತಿನ ಚೀಟಿ ಪಡೆಯಬೇಕು.",
    "file": "kn-169.mp3"
  },
  {
    "text": "ಶುಲ್ಕ ಪಾವತಿಸಲು ಬಂದಿದ್ದೇನೆ.",
    "file": "kn-170.mp3"
  },
  {
    "text": "ಈ ಕಾರ್ಯಕ್ರಮಕ್ಕೆ ನೋಂದಣಿ ಹೇಗೆ?",
    "file": "kn-171.mp3"
  },
  {
    "text": "ಕ್ಲಬ್‌ಗೆ ಸೇರಬಹುದಾ?",
    "file": "kn-172.mp3"
  },
  {
    "text": "ಪ್ರಮಾಣಪತ್ರ ಯಾವಾಗ ಸಿಗುತ್ತದೆ?",
    "file": "kn-173.mp3"
  },
  {
    "text": "ಅರ್ಜಿಯನ್ನು ಎಲ್ಲಿ ಕೊಡಬೇಕು?",
    "file": "kn-174.mp3"
  },
  {
    "text": "ಕೊನೆಯ ದಿನಾಂಕ ಯಾವುದು?",
    "file": "kn-175.mp3"
  },
  {
    "text": "ನಮಸ್ಕಾರ.",
    "file": "kn-176.mp3"
  },
  {
    "text": "ಶುಭೋದಯ.",
    "file": "kn-177.mp3"
  },
  {
    "text": "ನಾನು ಚೆನ್ನಾಗಿದ್ದೇನೆ.",
    "file": "kn-178.mp3"
  },
  {
    "text": "ನೀವು ಹೇಗಿದ್ದೀರಾ?",
    "file": "kn-179.mp3"
  },
  {
    "text": "ತುಂಬಾ ದಿನ ಆಯಿತು.",
    "file": "kn-180.mp3"
  },
  {
    "text": "ಮತ್ತೆ ಸಿಗೋಣ.",
    "file": "kn-181.mp3"
  },
  {
    "text": "ಶುಭ ರಾತ್ರಿ.",
    "file": "kn-182.mp3"
  },
  {
    "text": "ನನ್ನ ಹೆಸರು ಮೀರಾ.",
    "file": "kn-183.mp3"
  },
  {
    "text": "ನಾನು ಬೆಂಗಳೂರಿನಲ್ಲಿ ವಾಸಿಸುತ್ತೇನೆ.",
    "file": "kn-184.mp3"
  },
  {
    "text": "ನಾನು ಕೇರಳದಿಂದ ಬಂದಿದ್ದೇನೆ.",
    "file": "kn-185.mp3"
  },
  {
    "text": "ನಾನು ವಿದ್ಯಾರ್ಥಿ.",
    "file": "kn-186.mp3"
  },
  {
    "text": "ನನಗೆ ಸ್ವಲ್ಪ ಕನ್ನಡ ಗೊತ್ತು.",
    "file": "kn-187.mp3"
  },
  {
    "text": "ನಿಮ್ಮ ಬಗ್ಗೆ ಹೇಳಿ.",
    "file": "kn-188.mp3"
  },
  {
    "text": "ನಿಮ್ಮ ಮನೆಯಲ್ಲಿ ಎಷ್ಟು ಜನ?",
    "file": "kn-189.mp3"
  },
  {
    "text": "ನಮ್ಮ ಮನೆಯಲ್ಲಿ ನಾಲ್ಕು ಜನ.",
    "file": "kn-190.mp3"
  },
  {
    "text": "ನನಗೆ ಒಬ್ಬ ಅಣ್ಣ ಇದ್ದಾನೆ.",
    "file": "kn-191.mp3"
  },
  {
    "text": "ನನಗೆ ಒಬ್ಬ ತಂಗಿ ಇದ್ದಾಳೆ.",
    "file": "kn-192.mp3"
  },
  {
    "text": "ನಿಮ್ಮ ತಂದೆ ಏನು ಮಾಡುತ್ತಾರೆ?",
    "file": "kn-193.mp3"
  },
  {
    "text": "ನನ್ನ ತಾಯಿ ಶಿಕ್ಷಕಿ.",
    "file": "kn-194.mp3"
  },
  {
    "text": "ನನ್ನ ಕುಟುಂಬ ಊರಿನಲ್ಲಿ ಇದೆ.",
    "file": "kn-195.mp3"
  },
  {
    "text": "ಎಲ್ಲರೂ ಚೆನ್ನಾಗಿದ್ದಾರಾ?",
    "file": "kn-196.mp3"
  },
  {
    "text": "ನಿಮ್ಮ ಹವ್ಯಾಸ ಏನು?",
    "file": "kn-197.mp3"
  },
  {
    "text": "ನನಗೆ ಪುಸ್ತಕ ಓದುವುದು ಇಷ್ಟ.",
    "file": "kn-198.mp3"
  },
  {
    "text": "ನಾನು ಸಂಗೀತ ಕೇಳುತ್ತೇನೆ.",
    "file": "kn-199.mp3"
  },
  {
    "text": "ನಿಮಗೆ ಸಿನಿಮಾ ಇಷ್ಟವಾ?",
    "file": "kn-200.mp3"
  },
  {
    "text": "ನಾನು ವಾರಾಂತ್ಯದಲ್ಲಿ ಕ್ರಿಕೆಟ್ ಆಡುತ್ತೇನೆ.",
    "file": "kn-201.mp3"
  },
  {
    "text": "ನಿಮ್ಮ ನೆಚ್ಚಿನ ಹಾಡು ಯಾವುದು?",
    "file": "kn-202.mp3"
  },
  {
    "text": "ಬಿಡುವಿನ ಸಮಯದಲ್ಲಿ ಏನು ಮಾಡುತ್ತೀರಾ?",
    "file": "kn-203.mp3"
  },
  {
    "text": "ಒಟ್ಟಿಗೆ ಸಿನಿಮಾ ನೋಡೋಣವಾ?",
    "file": "kn-204.mp3"
  },
  {
    "text": "ದಯವಿಟ್ಟು ಕುಳಿತುಕೊಳ್ಳಿ.",
    "file": "kn-205.mp3"
  },
  {
    "text": "ತೊಂದರೆ ಕೊಟ್ಟಿದ್ದಕ್ಕೆ ಕ್ಷಮಿಸಿ.",
    "file": "kn-206.mp3"
  },
  {
    "text": "ಪರವಾಗಿಲ್ಲ.",
    "file": "kn-207.mp3"
  },
  {
    "text": "ತುಂಬಾ ಧನ್ಯವಾದಗಳು.",
    "file": "kn-208.mp3"
  },
  {
    "text": "ನಿಮ್ಮ ದಿನ ಹೇಗಿತ್ತು?",
    "file": "kn-209.mp3"
  },
  {
    "text": "ಹವಾಮಾನ ಚೆನ್ನಾಗಿದೆ, ಅಲ್ಲವೇ?",
    "file": "kn-210.mp3"
  },
  {
    "text": "ನಿಮ್ಮ ಅಭಿಪ್ರಾಯ ಏನು?",
    "file": "kn-211.mp3"
  },
  {
    "text": "ನಿಮ್ಮ ಜೊತೆ ಮಾತನಾಡಿ ಸಂತೋಷವಾಯಿತು.",
    "file": "kn-212.mp3"
  },
  {
    "text": "ನನಗೆ ಸಹಾಯ ಬೇಕು.",
    "file": "kn-213.mp3"
  },
  {
    "text": "ಯಾರಾದರೂ ಇದ್ದೀರಾ?",
    "file": "kn-214.mp3"
  },
  {
    "text": "ಪೊಲೀಸರನ್ನು ಕರೆಯಿರಿ.",
    "file": "kn-215.mp3"
  },
  {
    "text": "ಆಂಬುಲೆನ್ಸ್ ಕರೆಯಿರಿ.",
    "file": "kn-216.mp3"
  },
  {
    "text": "ಇದು ತುರ್ತು ಪರಿಸ್ಥಿತಿ.",
    "file": "kn-217.mp3"
  },
  {
    "text": "ದಯವಿಟ್ಟು ನನ್ನ ಜೊತೆ ಬನ್ನಿ.",
    "file": "kn-218.mp3"
  },
  {
    "text": "ನಾನು ಏನು ಮಾಡಬೇಕು?",
    "file": "kn-219.mp3"
  },
  {
    "text": "ನನ್ನ ಫೋನ್ ಕಳೆದುಹೋಗಿದೆ.",
    "file": "kn-220.mp3"
  },
  {
    "text": "ನನ್ನ ಪರ್ಸ್ ಕಾಣುತ್ತಿಲ್ಲ.",
    "file": "kn-221.mp3"
  },
  {
    "text": "ನನ್ನ ಸ್ನೇಹಿತ ಕಾಣುತ್ತಿಲ್ಲ.",
    "file": "kn-222.mp3"
  },
  {
    "text": "ನನ್ನ ವಾಹನ ಕೆಟ್ಟುಹೋಗಿದೆ.",
    "file": "kn-223.mp3"
  },
  {
    "text": "ನನಗೆ ಮನೆಗೆ ಹೋಗಬೇಕು.",
    "file": "kn-224.mp3"
  },
  {
    "text": "ಇಲ್ಲಿ ಸುರಕ್ಷಿತವಾಗಿಲ್ಲ.",
    "file": "kn-225.mp3"
  },
  {
    "text": "ನನಗೆ ಕನ್ನಡ ಚೆನ್ನಾಗಿ ಬರುವುದಿಲ್ಲ.",
    "file": "kn-226.mp3"
  },
  {
    "text": "ಪೊಲೀಸ್ ಠಾಣೆ ಎಲ್ಲಿದೆ?",
    "file": "kn-227.mp3"
  },
  {
    "text": "ನಾನು ದೂರು ಕೊಡಬೇಕು.",
    "file": "kn-228.mp3"
  },
  {
    "text": "ನನ್ನ ವಸ್ತು ಕಳುವಾಗಿದೆ.",
    "file": "kn-229.mp3"
  },
  {
    "text": "ನನ್ನನ್ನು ಯಾರೋ ಹಿಂಬಾಲಿಸುತ್ತಿದ್ದಾರೆ.",
    "file": "kn-230.mp3"
  },
  {
    "text": "ನನಗೆ ಸುರಕ್ಷಿತ ಸ್ಥಳ ಬೇಕು.",
    "file": "kn-231.mp3"
  },
  {
    "text": "ಈ ಘಟನೆ ಇಲ್ಲಿ ನಡೆಯಿತು.",
    "file": "kn-232.mp3"
  },
  {
    "text": "ನಾನು ಅವರನ್ನು ಗುರುತಿಸಬಲ್ಲೆ.",
    "file": "kn-233.mp3"
  },
  {
    "text": "ನನ್ನ ಕುಟುಂಬಕ್ಕೆ ಕರೆ ಮಾಡಬಹುದಾ?",
    "file": "kn-234.mp3"
  },
  {
    "text": "ನಾನು ಈ ವಿಳಾಸದಲ್ಲಿದ್ದೇನೆ.",
    "file": "kn-235.mp3"
  },
  {
    "text": "ತಕ್ಷಣ ಇಲ್ಲಿಗೆ ಬನ್ನಿ.",
    "file": "kn-236.mp3"
  },
  {
    "text": "ನನ್ನ ಸ್ಥಳ ಕಳುಹಿಸುತ್ತೇನೆ.",
    "file": "kn-237.mp3"
  },
  {
    "text": "ನನ್ನ ಫೋನ್ ಬ್ಯಾಟರಿ ಕಡಿಮೆ ಇದೆ.",
    "file": "kn-238.mp3"
  },
  {
    "text": "ಈ ಸಂಖ್ಯೆಗೆ ಕರೆ ಮಾಡಿ.",
    "file": "kn-239.mp3"
  },
  {
    "text": "ನನ್ನ ಮಾತನ್ನು ನಿಧಾನವಾಗಿ ಕೇಳಿ.",
    "file": "kn-240.mp3"
  },
  {
    "text": "ಸಹಾಯ ಬರುವವರೆಗೆ ಇಲ್ಲೇ ಇರಿ.",
    "file": "kn-241.mp3"
  },
  {
    "text": "ಮತ್ತೊಮ್ಮೆ ಹೇಳಿ.",
    "file": "kn-242.mp3"
  },
  {
    "text": "ಇದನ್ನು ಬರೆದು ಕೊಡುತ್ತೀರಾ?",
    "file": "kn-243.mp3"
  },
  {
    "text": "ಕುಡಿಯುವ ನೀರು ಎಲ್ಲಿದೆ?",
    "file": "kn-244.mp3"
  },
  {
    "text": "ನನಗೆ ಇಂಟರ್ನೆಟ್ ಬೇಕು.",
    "file": "kn-245.mp3"
  },
  {
    "text": "ಧನ್ಯವಾದಗಳು, ಈಗ ಅರ್ಥವಾಯಿತು.",
    "file": "kn-246.mp3"
  },
  {
    "text": "ನಮಸ್ಕಾರ, ನಾನು ನಿಮ್ಮ ಹೊಸ ನೆರೆಹೊರೆಯವನು.",
    "file": "kn-247.mp3"
  },
  {
    "text": "ನಾವು ಪಕ್ಕದ ಮನೆಯಲ್ಲಿ ವಾಸಿಸುತ್ತೇವೆ.",
    "file": "kn-248.mp3"
  },
  {
    "text": "ಈ ಪ್ರದೇಶ ಹೇಗಿದೆ?",
    "file": "kn-249.mp3"
  },
  {
    "text": "ಹತ್ತಿರದಲ್ಲಿ ಅಂಗಡಿ ಇದೆಯಾ?",
    "file": "kn-250.mp3"
  },
  {
    "text": "ಯಾವುದಾದರೂ ಸಹಾಯ ಬೇಕಾದರೆ ಹೇಳಿ.",
    "file": "kn-251.mp3"
  },
  {
    "text": "ಮನೆಗೆ ಬನ್ನಿ.",
    "file": "kn-252.mp3"
  },
  {
    "text": "ಬಾಗಿಲು ಮುಚ್ಚಿ, ದಯವಿಟ್ಟು.",
    "file": "kn-253.mp3"
  },
  {
    "text": "ಕಿಟಕಿ ತೆರೆಯುತ್ತೀರಾ?",
    "file": "kn-254.mp3"
  },
  {
    "text": "ಲೈಟ್ ಆಫ್ ಮಾಡಿ.",
    "file": "kn-255.mp3"
  },
  {
    "text": "ಸ್ವಲ್ಪ ನೀರು ಕೊಡುತ್ತೀರಾ?",
    "file": "kn-256.mp3"
  },
  {
    "text": "ಇದನ್ನು ಇಲ್ಲಿ ಇಡಿ.",
    "file": "kn-257.mp3"
  },
  {
    "text": "ಸ್ವಲ್ಪ ಜಾಗ ಕೊಡುತ್ತೀರಾ?",
    "file": "kn-258.mp3"
  },
  {
    "text": "ದಯವಿಟ್ಟು ಶಬ್ದ ಕಡಿಮೆ ಮಾಡಿ.",
    "file": "kn-259.mp3"
  },
  {
    "text": "ನಾನು ಸಹಾಯ ಮಾಡುತ್ತೇನೆ.",
    "file": "kn-260.mp3"
  },
  {
    "text": "ಯಾರು ಬಂದಿದ್ದಾರೆ?",
    "file": "kn-261.mp3"
  },
  {
    "text": "ನಾನು ಕೆಳಗೆ ಬರುತ್ತೇನೆ.",
    "file": "kn-262.mp3"
  },
  {
    "text": "ಪಾರ್ಸೆಲ್ ಬಾಗಿಲ ಬಳಿ ಇಡಿ.",
    "file": "kn-263.mp3"
  },
  {
    "text": "ಯಾವ ಫ್ಲಾಟ್ ನಂಬರ್?",
    "file": "kn-264.mp3"
  },
  {
    "text": "ನಾನು ಈ ಪಾರ್ಸೆಲ್ ಆರ್ಡರ್ ಮಾಡಿಲ್ಲ.",
    "file": "kn-265.mp3"
  },
  {
    "text": "ಒಳಗೆ ಬನ್ನಿ, ದಯವಿಟ್ಟು.",
    "file": "kn-266.mp3"
  },
  {
    "text": "ಚಪ್ಪಲಿ ಹೊರಗೆ ಬಿಡಿ.",
    "file": "kn-267.mp3"
  },
  {
    "text": "ಚಹಾ ಅಥವಾ ಕಾಫಿ ಬೇಕಾ?",
    "file": "kn-268.mp3"
  },
  {
    "text": "ಮನೆಯಲ್ಲಿ ವಿದ್ಯುತ್ ಇಲ್ಲ.",
    "file": "kn-269.mp3"
  },
  {
    "text": "ನೀರು ಬರುತ್ತಿಲ್ಲ.",
    "file": "kn-270.mp3"
  },
  {
    "text": "ನಳ ಸೋರುತ್ತಿದೆ.",
    "file": "kn-271.mp3"
  },
  {
    "text": "ಫ್ಯಾನ್ ಕೆಲಸ ಮಾಡುತ್ತಿಲ್ಲ.",
    "file": "kn-272.mp3"
  },
  {
    "text": "ದುರಸ್ತಿ ಮಾಡಲು ಯಾವಾಗ ಬರುತ್ತೀರಾ?",
    "file": "kn-273.mp3"
  },
  {
    "text": "ಇದನ್ನು ಸರಿಪಡಿಸಲು ಎಷ್ಟು ಆಗುತ್ತದೆ?",
    "file": "kn-274.mp3"
  },
  {
    "text": "ಮನೆಯ ಮಾಲೀಕರಿಗೆ ತಿಳಿಸಿದ್ದೀರಾ?",
    "file": "kn-275.mp3"
  },
  {
    "text": "ಕೆಲಸ ಮುಗಿದ ಮೇಲೆ ಕರೆ ಮಾಡಿ.",
    "file": "kn-276.mp3"
  },
  {
    "text": "ನಾನು ಬೆಳಿಗ್ಗೆ ಬೇಗ ಎದ್ದೇಳುತ್ತೇನೆ.",
    "file": "kn-277.mp3"
  },
  {
    "text": "ನಾನು ಈಗ ಅಡುಗೆ ಮಾಡುತ್ತಿದ್ದೇನೆ.",
    "file": "kn-278.mp3"
  },
  {
    "text": "ಊಟ ಸಿದ್ಧವಾಗಿದೆ.",
    "file": "kn-279.mp3"
  },
  {
    "text": "ನಾವು ಮನೆ ಸ್ವಚ್ಛ ಮಾಡಬೇಕು.",
    "file": "kn-280.mp3"
  },
  {
    "text": "ನೀವು ಊಟ ಮಾಡಿದ್ದೀರಾ?",
    "file": "kn-281.mp3"
  },
  {
    "text": "ಇನ್ನೂ ಸ್ವಲ್ಪ ತೆಗೆದುಕೊಳ್ಳಿ.",
    "file": "kn-282.mp3"
  },
  {
    "text": "ಆರಾಮವಾಗಿ ಕುಳಿತುಕೊಳ್ಳಿ.",
    "file": "kn-283.mp3"
  },
  {
    "text": "ಮತ್ತೆ ಮನೆಗೆ ಬನ್ನಿ.",
    "file": "kn-284.mp3"
  },
  {
    "text": "ಔಷಧ ಅಂಗಡಿ ಎಲ್ಲಿದೆ?",
    "file": "kn-285.mp3"
  },
  {
    "text": "ಜ್ವರಕ್ಕೆ ಔಷಧ ಬೇಕು.",
    "file": "kn-286.mp3"
  },
  {
    "text": "ತಲೆನೋವಿಗೆ ಮಾತ್ರೆ ಇದೆಯಾ?",
    "file": "kn-287.mp3"
  },
  {
    "text": "ವೈದ್ಯರ ಚೀಟಿ ಬೇಕಾ?",
    "file": "kn-288.mp3"
  },
  {
    "text": "ಇದನ್ನು ಯಾವಾಗ ತೆಗೆದುಕೊಳ್ಳಬೇಕು?",
    "file": "kn-289.mp3"
  },
  {
    "text": "ದಿನಕ್ಕೆ ಎಷ್ಟು ಬಾರಿ?",
    "file": "kn-290.mp3"
  },
  {
    "text": "ಊಟದ ನಂತರ ತೆಗೆದುಕೊಳ್ಳಬೇಕಾ?",
    "file": "kn-291.mp3"
  },
  {
    "text": "ಇದರಿಂದ ನಿದ್ರೆ ಬರುತ್ತದೆಯಾ?",
    "file": "kn-292.mp3"
  },
  {
    "text": "ನನಗೆ ಜ್ವರ ಇದೆ.",
    "file": "kn-293.mp3"
  },
  {
    "text": "ನನಗೆ ತಲೆನೋವು ಇದೆ.",
    "file": "kn-294.mp3"
  },
  {
    "text": "ಗಂಟಲು ನೋಯುತ್ತಿದೆ.",
    "file": "kn-295.mp3"
  },
  {
    "text": "ಹೊಟ್ಟೆ ನೋಯುತ್ತಿದೆ.",
    "file": "kn-296.mp3"
  },
  {
    "text": "ನನಗೆ ಕೆಮ್ಮು ಇದೆ.",
    "file": "kn-297.mp3"
  },
  {
    "text": "ಉಸಿರಾಡಲು ಕಷ್ಟವಾಗುತ್ತಿದೆ.",
    "file": "kn-298.mp3"
  },
  {
    "text": "ನನಗೆ ತಲೆ ಸುತ್ತುತ್ತಿದೆ.",
    "file": "kn-299.mp3"
  },
  {
    "text": "ಇದು ಎರಡು ದಿನಗಳಿಂದ ಇದೆ.",
    "file": "kn-300.mp3"
  },
  {
    "text": "ವೈದ್ಯರ ಸಮಯ ಬೇಕು.",
    "file": "kn-301.mp3"
  },
  {
    "text": "ಇಂದು ಸಮಯ ಸಿಗುತ್ತದೆಯಾ?",
    "file": "kn-302.mp3"
  },
  {
    "text": "ವೈದ್ಯರು ಯಾವಾಗ ಬರುತ್ತಾರೆ?",
    "file": "kn-303.mp3"
  },
  {
    "text": "ನನ್ನ ಹೆಸರು ರವಿ.",
    "file": "kn-304.mp3"
  },
  {
    "text": "ನನ್ನ ಸಮಯ ಹತ್ತು ಗಂಟೆಗೆ.",
    "file": "kn-305.mp3"
  },
  {
    "text": "ಸಮಯ ಬದಲಾಯಿಸಬಹುದಾ?",
    "file": "kn-306.mp3"
  },
  {
    "text": "ಎಷ್ಟು ಹೊತ್ತು ಕಾಯಬೇಕು?",
    "file": "kn-307.mp3"
  },
  {
    "text": "ದಯವಿಟ್ಟು ದೃಢೀಕರಿಸಿ.",
    "file": "kn-308.mp3"
  },
  {
    "text": "ನಾನು ವೈದ್ಯರನ್ನು ನೋಡಲು ಬಂದಿದ್ದೇನೆ.",
    "file": "kn-309.mp3"
  },
  {
    "text": "ನನಗೆ ಈ ಔಷಧ ಅಲರ್ಜಿ ಇದೆ.",
    "file": "kn-310.mp3"
  },
  {
    "text": "ನಾನು ಈಗಾಗಲೇ ಈ ಮಾತ್ರೆ ತೆಗೆದುಕೊಳ್ಳುತ್ತಿದ್ದೇನೆ.",
    "file": "kn-311.mp3"
  },
  {
    "text": "ಪರೀಕ್ಷೆ ಮಾಡಿಸಬೇಕಾ?",
    "file": "kn-312.mp3"
  },
  {
    "text": "ವರದಿ ಯಾವಾಗ ಸಿಗುತ್ತದೆ?",
    "file": "kn-313.mp3"
  },
  {
    "text": "ಇದು ಗಂಭೀರವೇ?",
    "file": "kn-314.mp3"
  },
  {
    "text": "ನಾನು ಏನು ತಿನ್ನಬಾರದು?",
    "file": "kn-315.mp3"
  },
  {
    "text": "ಮತ್ತೆ ಯಾವಾಗ ಬರಬೇಕು?",
    "file": "kn-316.mp3"
  },
  {
    "text": "ಸೇವಾ ಕೇಂದ್ರ ಎಲ್ಲಿದೆ?",
    "file": "kn-317.mp3"
  },
  {
    "text": "ನನಗೆ ಈ ಅರ್ಜಿ ತುಂಬಲು ಸಹಾಯ ಬೇಕು.",
    "file": "kn-318.mp3"
  },
  {
    "text": "ಯಾವ ದಾಖಲೆಗಳು ಬೇಕು?",
    "file": "kn-319.mp3"
  },
  {
    "text": "ನನ್ನ ಸರದಿ ಯಾವಾಗ?",
    "file": "kn-320.mp3"
  },
  {
    "text": "ಈ ಕೌಂಟರ್‌ನಲ್ಲಿ ಕೇಳಬೇಕಾ?",
    "file": "kn-321.mp3"
  },
  {
    "text": "ನನ್ನ ಅರ್ಜಿಯ ಸ್ಥಿತಿ ಏನು?",
    "file": "kn-322.mp3"
  },
  {
    "text": "ನನಗೆ ನಕಲು ಪ್ರತಿ ಬೇಕು.",
    "file": "kn-323.mp3"
  },
  {
    "text": "ಈ ಸೇವೆ ಯಾವಾಗ ಮುಚ್ಚುತ್ತದೆ?",
    "file": "kn-324.mp3"
  },
  {
    "text": "ಊಟ ಆರ್ಡರ್ ಮಾಡುವುದು",
    "file": "kn-001.mp3"
  },
  {
    "text": "ಮೆನು ಅರ್ಥಮಾಡಿಕೊಳ್ಳುವುದು",
    "file": "kn-002.mp3"
  },
  {
    "text": "ಊಟದಲ್ಲಿ ಬದಲಾವಣೆ",
    "file": "kn-325.mp3"
  },
  {
    "text": "ಪಾನೀಯಗಳು ಮತ್ತು ಸಿಹಿ",
    "file": "kn-326.mp3"
  },
  {
    "text": "ಬಿಲ್ ಮತ್ತು ಪಾವತಿ",
    "file": "kn-327.mp3"
  },
  {
    "text": "ಆಟೋ ಪ್ರಯಾಣ",
    "file": "kn-328.mp3"
  },
  {
    "text": "ಬಸ್ ಪ್ರಯಾಣ",
    "file": "kn-329.mp3"
  },
  {
    "text": "ದಾರಿ ಕೇಳುವುದು",
    "file": "kn-330.mp3"
  },
  {
    "text": "ದರ ಮತ್ತು ಟಿಕೆಟ್",
    "file": "kn-331.mp3"
  },
  {
    "text": "ಪ್ರಯಾಣದ ಸಮಸ್ಯೆಗಳು",
    "file": "kn-332.mp3"
  },
  {
    "text": "ಬೆಲೆ ಕೇಳುವುದು",
    "file": "kn-333.mp3"
  },
  {
    "text": "ವಿನಯವಾಗಿ ಚೌಕಾಸಿ",
    "file": "kn-334.mp3"
  },
  {
    "text": "ಪ್ರಮಾಣ ಮತ್ತು ದಿನಸಿ",
    "file": "kn-335.mp3"
  },
  {
    "text": "ಬಟ್ಟೆ ಖರೀದಿ",
    "file": "kn-336.mp3"
  },
  {
    "text": "ಪಾವತಿ ಮತ್ತು ವಾಪಸಾತಿ",
    "file": "kn-337.mp3"
  },
  {
    "text": "ಕ್ಯಾಂಪಸ್ ಪರಿಚಯ",
    "file": "kn-338.mp3"
  },
  {
    "text": "ಸಹಪಾಠಿಗಳ ಜೊತೆ ಮಾತು",
    "file": "kn-339.mp3"
  },
  {
    "text": "ತರಗತಿ ಹುಡುಕುವುದು",
    "file": "kn-340.mp3"
  },
  {
    "text": "ಶಿಕ್ಷಕರು ಮತ್ತು ಸಂದೇಹಗಳು",
    "file": "kn-341.mp3"
  },
  {
    "text": "ಕ್ಯಾಂಪಸ್ ಸೇವೆಗಳು",
    "file": "kn-342.mp3"
  },
  {
    "text": "ದೈನಂದಿನ ಶುಭಾಶಯಗಳು",
    "file": "kn-343.mp3"
  },
  {
    "text": "ಸ್ವಪರಿಚಯ",
    "file": "kn-344.mp3"
  },
  {
    "text": "ಕುಟುಂಬದ ಬಗ್ಗೆ ಮಾತು",
    "file": "kn-345.mp3"
  },
  {
    "text": "ಹವ್ಯಾಸ ಮತ್ತು ಬಿಡುವಿನ ಸಮಯ",
    "file": "kn-346.mp3"
  },
  {
    "text": "ವಿನಯದ ಸಣ್ಣ ಮಾತು",
    "file": "kn-347.mp3"
  },
  {
    "text": "ಸಹಾಯ ಕೇಳುವುದು",
    "file": "kn-348.mp3"
  },
  {
    "text": "ಸಮಸ್ಯೆ ವಿವರಿಸುವುದು",
    "file": "kn-349.mp3"
  },
  {
    "text": "ಪೊಲೀಸ್ ಮತ್ತು ಸುರಕ್ಷತೆ",
    "file": "kn-350.mp3"
  },
  {
    "text": "ತುರ್ತು ಸಂವಹನ",
    "file": "kn-351.mp3"
  },
  {
    "text": "ಅಗತ್ಯ ಮಾತುಗಳು",
    "file": "kn-352.mp3"
  },
  {
    "text": "ನೆರೆಹೊರೆಯವರ ಪರಿಚಯ",
    "file": "kn-353.mp3"
  },
  {
    "text": "ಮನೆಯ ವಿನಂತಿಗಳು",
    "file": "kn-354.mp3"
  },
  {
    "text": "ಡೆಲಿವರಿ ಮತ್ತು ಅತಿಥಿಗಳು",
    "file": "kn-355.mp3"
  },
  {
    "text": "ಸೌಲಭ್ಯ ಮತ್ತು ದುರಸ್ತಿ",
    "file": "kn-356.mp3"
  },
  {
    "text": "ದಿನಚರಿ ಮತ್ತು ಅತಿಥಿಗಳು",
    "file": "kn-357.mp3"
  },
  {
    "text": "ಔಷಧ ಅಂಗಡಿಯಲ್ಲಿ",
    "file": "kn-358.mp3"
  },
  {
    "text": "ಲಕ್ಷಣಗಳನ್ನು ಹೇಳುವುದು",
    "file": "kn-359.mp3"
  },
  {
    "text": "ವೈದ್ಯರ ಸಮಯ ಪಡೆಯುವುದು",
    "file": "kn-360.mp3"
  },
  {
    "text": "ಆಸ್ಪತ್ರೆಯಲ್ಲಿ ಮಾತು",
    "file": "kn-361.mp3"
  },
  {
    "text": "ಅಗತ್ಯ ಸೇವೆಗಳು",
    "file": "kn-362.mp3"
  },
  {
    "text": "ನೀವು",
    "file": "kn-363.mp3"
  },
  {
    "text": "ನೀನು",
    "file": "kn-364.mp3"
  },
  {
    "text": "ಮಾಡಿ",
    "file": "kn-365.mp3"
  },
  {
    "text": "ನಮಸ್ಕಾರ! ನಿಮಗೆ ಏನು ಬೇಕು?",
    "file": "kn-366.mp3"
  },
  {
    "text": "ಖಾರ ಬೇಕಾ?",
    "file": "kn-367.mp3"
  },
  {
    "text": "ಖಾರ ಕಡಿಮೆ ಮಾಡಲಾ?",
    "file": "kn-368.mp3"
  },
  {
    "text": "ಹೌದು, ದಯವಿಟ್ಟು.",
    "file": "kn-369.mp3"
  },
  {
    "text": "ಆಯಿತು. ಇನ್ನೇನಾದರೂ ಬೇಕಾ?",
    "file": "kn-370.mp3"
  },
  {
    "text": "ಸಂದರ್ಭಕ್ಕೆ ಸರಿಯಾದ ಮಾತನ್ನು ಆರಿಸಿ.",
    "file": "kn-371.mp3"
  },
  {
    "text": "ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ",
    "file": "kn-372.mp3"
  },
  {
    "text": "ಎಲ್ಲಿಗೆ ಹೋಗಬೇಕು?",
    "file": "kn-373.mp3"
  },
  {
    "text": "ಮೂರು ನೂರು ರೂಪಾಯಿ ಆಗುತ್ತದೆ.",
    "file": "kn-374.mp3"
  },
  {
    "text": "ಮೀಟರ್ ಹಾಕಿ, ದಯವಿಟ್ಟು.",
    "file": "kn-375.mp3"
  },
  {
    "text": "ಸರಿ, ಹೋಗೋಣ.",
    "file": "kn-376.mp3"
  },
  {
    "text": "ಇಲ್ಲಿ ನಿಲ್ಲಿಸಬೇಕಾ?",
    "file": "kn-377.mp3"
  },
  {
    "text": "ಹೌದು, ಇಲ್ಲೇ ನಿಲ್ಲಿಸಿ.",
    "file": "kn-378.mp3"
  },
  {
    "text": "ಏನು ಬೇಕು?",
    "file": "kn-379.mp3"
  },
  {
    "text": "ಒಂದು ಕಿಲೋ ಟೊಮೇಟೊ ಬೇಕು.",
    "file": "kn-380.mp3"
  },
  {
    "text": "ಒಂದು ಕಿಲೋ ಅರವತ್ತು ರೂಪಾಯಿ.",
    "file": "kn-381.mp3"
  },
  {
    "text": "ಸರಿ, ಒಂದು ಕಿಲೋ ಕೊಡಿ.",
    "file": "kn-382.mp3"
  },
  {
    "text": "ಚೀಲ ಬೇಕಾ?",
    "file": "kn-383.mp3"
  },
  {
    "text": "ನಮಸ್ಕಾರ, ನೀವು ಹೊಸಬರಾ?",
    "file": "kn-384.mp3"
  },
  {
    "text": "ಹೌದು, ನಾನು ಮೊದಲ ವರ್ಷದ ವಿದ್ಯಾರ್ಥಿ.",
    "file": "kn-385.mp3"
  },
  {
    "text": "ಬಿಲ್ ಕೊಡಿ.",
    "file": "kn-386.mp3"
  },
  {
    "text": "ನಿಮ್ಮ ತರಗತಿ ಯಾವುದು?",
    "file": "kn-387.mp3"
  },
  {
    "text": "ಕಂಪ್ಯೂಟರ್ ಸೈನ್ಸ್ ತರಗತಿ ಎಲ್ಲಿ?",
    "file": "kn-388.mp3"
  },
  {
    "text": "ನನಗೆ ಗೊತ್ತಿಲ್ಲ.",
    "file": "kn-389.mp3"
  },
  {
    "text": "ನಾನು ದಾರಿ ತೋರಿಸುತ್ತೇನೆ.",
    "file": "kn-390.mp3"
  },
  {
    "text": "ನಮಸ್ಕಾರ, ನೀವು ಹೊಸದಾಗಿ ಬಂದಿದ್ದೀರಾ?",
    "file": "kn-391.mp3"
  },
  {
    "text": "ಹೌದು, ನಾನು ಪಕ್ಕದ ಮನೆಯಲ್ಲಿ ವಾಸಿಸುತ್ತೇನೆ.",
    "file": "kn-392.mp3"
  },
  {
    "text": "ನನ್ನ ಹೆಸರು ಕಿರಣ್.",
    "file": "kn-393.mp3"
  },
  {
    "text": "ನನಗೂ ಸಂತೋಷವಾಯಿತು.",
    "file": "kn-394.mp3"
  },
  {
    "text": "ಏನಾಯಿತು?",
    "file": "kn-395.mp3"
  },
  {
    "text": "ನೀವು ಎಲ್ಲಿಗೆ ಹೋಗಬೇಕು?",
    "file": "kn-396.mp3"
  },
  {
    "text": "ನನಗೆ ಈ ವಿಳಾಸಕ್ಕೆ ಹೋಗಬೇಕು.",
    "file": "kn-397.mp3"
  },
  {
    "text": "ನನ್ನ ಕುಟುಂಬಕ್ಕೆ ಕರೆ ಮಾಡಬೇಕು.",
    "file": "kn-398.mp3"
  },
  {
    "text": "ನಾನು ನಿಮಗೆ ಸಹಾಯ ಮಾಡುತ್ತೇನೆ.",
    "file": "kn-399.mp3"
  },
  {
    "text": "ನಿಮ್ಮ ಮನೆ ಎಲ್ಲಿ?",
    "file": "kn-400.mp3"
  },
  {
    "text": "ಎರಡನೇ ಮಹಡಿ, ಫ್ಲಾಟ್ ಇಪ್ಪತ್ತು.",
    "file": "kn-401.mp3"
  },
  {
    "text": "ನಾನು ಮೇಲಕ್ಕೆ ಬರಬೇಕಾ?",
    "file": "kn-402.mp3"
  },
  {
    "text": "ಹೌದು, ಮೇಲಕ್ಕೆ ಬನ್ನಿ.",
    "file": "kn-403.mp3"
  },
  {
    "text": "ಪಾರ್ಸೆಲ್ ಇಲ್ಲಿದೆ.",
    "file": "kn-404.mp3"
  },
  {
    "text": "ಧನ್ಯವಾದಗಳು.",
    "file": "kn-405.mp3"
  },
  {
    "text": "ನಿಮಗೆ ಏನು ಬೇಕು?",
    "file": "kn-406.mp3"
  },
  {
    "text": "ತಲೆನೋವಿಗೆ ಮಾತ್ರೆ ಬೇಕು.",
    "file": "kn-407.mp3"
  },
  {
    "text": "ಜ್ವರ ಇದೆಯಾ?",
    "file": "kn-408.mp3"
  },
  {
    "text": "ಇಲ್ಲ, ತಲೆನೋವು ಮಾತ್ರ.",
    "file": "kn-409.mp3"
  },
  {
    "text": "ಹೌದು, ಸ್ವಲ್ಪ ಜ್ವರ ಇದೆ.",
    "file": "kn-410.mp3"
  },
  {
    "text": "ಊಟದ ನಂತರ ತೆಗೆದುಕೊಳ್ಳಿ.",
    "file": "kn-411.mp3"
  },
  {
    "text": "ಸರಿ, ಧನ್ಯವಾದಗಳು.",
    "file": "kn-412.mp3"
  },
  {
    "text": "ನನಗೆ ಒಂದು ದೋಸೆ ಬೇಕು",
    "file": "kn-413.mp3"
  },
  {
    "text": "ಬೇಕು",
    "file": "kn-414.mp3"
  },
  {
    "text": "ನಿಲ್ಲಿಸಿ",
    "file": "kn-415.mp3"
  },
  {
    "text": "ಇಲ್ಲೇ ನಿಲ್ಲಿಸಿ",
    "file": "kn-416.mp3"
  },
  {
    "text": "ಎಷ್ಟು ಸಮಯ?",
    "file": "kn-417.mp3"
  },
  {
    "text": "ಬಸ್ ಎಲ್ಲಿದೆ?",
    "file": "kn-418.mp3"
  },
  {
    "text": "ಇದರ ಬೆಲೆ ಎಷ್ಟು",
    "file": "kn-419.mp3"
  },
  {
    "text": "ಬೆಲೆ",
    "file": "kn-420.mp3"
  },
  {
    "text": "ಕಲಿಯುತ್ತಿದ್ದೇನೆ",
    "file": "kn-421.mp3"
  },
  {
    "text": "ತರಗತಿ ಎಲ್ಲಿದೆ?",
    "file": "kn-422.mp3"
  },
  {
    "text": "ನಾನು",
    "file": "kn-423.mp3"
  },
  {
    "text": "ಕ್ಷಮಿಸಿ",
    "file": "kn-424.mp3"
  },
  {
    "text": "ತುಂಬಾ ಧನ್ಯವಾದಗಳು",
    "file": "kn-425.mp3"
  },
  {
    "text": "ನನಗೆ ಊಟ ಬೇಕು.",
    "file": "kn-426.mp3"
  },
  {
    "text": "ಬಾಡಿಗೆ ಎಷ್ಟು?",
    "file": "kn-427.mp3"
  },
  {
    "text": "ಕಾಲೇಜು ಎಲ್ಲಿದೆ?",
    "file": "kn-428.mp3"
  },
  {
    "text": "ಪರವಾಗಿಲ್ಲ! ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ.",
    "file": "kn-429.mp3"
  }
]